{
  "name": "@cocreate/wake-lock",
  "version": "1.0.0",
  "description": "Helpers for the browser Screen Wake Lock API.",
  "keywords": [
    "wake-lock",
    "screen",
    "browser-api",
    "low-code",
    "html5-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "Helpers for the browser Screen Wake Lock API.",
      "source": "src/index.js",
      "declarative": {
        "selectors": [
          "[wake-lock]"
        ],
        "attributes": [
          {
            "name": "actions"
          },
          {
            "name": "wake-lock"
          },
          {
            "name": "wake-lock-type"
          }
        ],
        "actions": [
          {
            "name": "wakeLock"
          }
        ]
      },
      "api": {
        "exports": [
          "isSupported",
          "release",
          "request"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/CoCreate-wake-lock.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/CoCreate-wake-lock/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/wake-lock",
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/actions": "^1.27.0",
    "@cocreate/observer": "^1.25.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "allowScripts": {
    "@cocreate/actions@1.27.0": true,
    "@cocreate/observer@1.25.0": true,
    "@cocreate/webpack@1.9.0": true
  }
}
